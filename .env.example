# Usage Metering & Billing Engine — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.

# HTTP port for the API
PORT=3000

# SQLite database file (created automatically by `npm run migrate` / `npm start`)
DATABASE_FILE=dev.db

# --- Stripe (TEST MODE ONLY) -------------------------------------------------
# Test-mode secret key, e.g. sk_test_51...
# Get it from the Stripe dashboard -> Developers -> API keys -> Secret key.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Webhook signing secret. Run `stripe listen --forward-to localhost:3000/webhooks/stripe`
# and copy the `whsec_...` value printed by the CLI.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Stripe Price id for the Pro subscription created by `npm run seed`
# (auto-created in test mode when STRIPE_SECRET_KEY is present).
STRIPE_PRICE_PRO=price_REPLACE_ME

# --- Jobs --------------------------------------------------------------------
# Background rollup interval in ms (0 = disabled; run `npm run rollup` manually).
ROLLUP_INTERVAL_MS=0
JOB_MAX_ATTEMPTS=3
JOB_BASE_BACKOFF_MS=250